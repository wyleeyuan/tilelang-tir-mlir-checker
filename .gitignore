# Keep the repository focused on package code, tests and one usage entry.
# Run outputs and research archives belong outside this checkout.
/*
!/.gitignore
!/.gitattributes
!/MANIFEST.in
!/pyproject.toml
!/README.md
!/tir_mlir_checker/
!/tests/
!/scripts/
/scripts/*
!/scripts/run-tir-mlir-mcp.sh
!/skills/
/skills/*
!/skills/tir-mlir-check/
/skills/tir-mlir-check/*
!/skills/tir-mlir-check/SKILL.md

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
.DS_Store
.env
.env.*
*.pem
*.key
